# Set default behavior to automatically normalize line endings
* text=auto

# Force LF for source code files to ensure cross-platform compatibility
*.php text eol=lf
*.js text eol=lf
*.css text eol=lf
*.json text eol=lf
*.md text eol=lf

# Denote binary files (prevent Git from attempting to normalize them)
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.gif binary
*.zip binary
